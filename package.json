{
  "name": "kalien",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "deploy": "bash worker/ops/deploy.sh",
    "smoke": "bun worker/ops/smoke.ts",
    "typegen": "WRANGLER_LOG_PATH=.wrangler/logs wrangler types",
    "typegen:check": "WRANGLER_LOG_PATH=.wrangler/logs wrangler types --check",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:cli": "tsc --noEmit -p cli/tsconfig.json",
    "typecheck": "bun run typegen:check && bun run typecheck:app && bun run typecheck:node && bun run typecheck:worker && bun run typecheck:scripts && bun run typecheck:cli",
    "lint": "oxlint src worker",
    "lint:fix": "oxlint src worker --fix",
    "format": "oxfmt src worker --write",
    "format:check": "oxfmt src worker --check",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@fontsource/monaspace-krypton": "^5.2.5",
    "@fontsource/monaspace-neon": "^5.2.5",
    "@noble/hashes": "2.2.0",
    "@radix-ui/react-slot": "1.2.3",
    "@tailwindcss/vite": "^4.2.1",
    "@thruputchain/client": "0.18.0",
    "@thruputchain/protocol": "0.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.5",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.71.0"
  }
}
