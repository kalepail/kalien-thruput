{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalien-thruput",
  "account_id": "ba55b7ae9acfb3ed152103e3497c0752",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
    },
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
  },
  "vars": {
    // Network and contracts come from shared/thruput/deployments/devnet.json at
    // build time. Set these only to override it (for example, a local node:
    // set THRUPUT_RPC_URL and the contracts in .dev.vars).
    "THRUPUT_RPC_URL": "",
    "THRUPUT_NETWORK_HASH": "",
    "SCORE_CONTRACT": "",
    "TOKEN_CONTRACT": "",
    "EXPLORER_URL": "",
    // Relay gas (see docs/thruput/kt-worker.md). Child gas = base + per_frame * frames,
    // capped at max. Each in-flight run reserves its gas limit in free HOG (not burned).
    // An out-of-gas fault gets one retry at 1.5x, up to RELAY_GAS_RETRY_MAX.
    "RELAY_GAS_BASE": "5000000",
    "RELAY_GAS_PER_FRAME": "3000",
    "RELAY_GAS_MAX": "113000000",
    "RELAY_GAS_RETRY_MAX": "150000000",
    "RELAY_WALLET_GAS_OVERHEAD": "100000",
    "RELAY_SEED_GAS": "1000000",
    "RELAY_EXPIRY_BLOCKS": "120",
    "RELAY_MAX_IN_FLIGHT": "4",
    // Leaderboard indexer (ScoreSubmitted events → D1), every minute.
    "LEADERBOARD_SYNC_ENABLED": "1",
    "LEADERBOARD_SYNC_MAX_PAGES": "10",
  },
  // Secrets. RELAY_SECRETS: comma-separated relay Ed25519 seeds (hex), one per lane.
  // DEV_API_KEY: guards /api/admin/*. Listing them here also keeps `wrangler types`
  // independent of .dev.vars.
  "secrets": {
    "required": ["RELAY_SECRETS", "DEV_API_KEY"],
  },
  "d1_databases": [
    {
      "binding": "LEADERBOARD_DB",
      "database_name": "kalien-thruput-leaderboard",
      "database_id": "5bd1495c-f925-4571-bf8c-adde06c93236",
      "migrations_dir": "worker/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "TAPES",
      "bucket_name": "kalien-thruput-tapes",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-relay",
      "new_sqlite_classes": ["RelayDO"],
    },
  ],
  "triggers": {
    // */1: leaderboard indexer. */10: touch the current seed epoch.
    "crons": ["*/1 * * * *", "*/10 * * * *"],
  },

  // Local development against `thruput node` (CLOUDFLARE_ENV=local). It reads every key
  // from .dev.vars.local: RELAY_SECRETS, DEV_API_KEY, THRUPUT_RPC_URL, SCORE_CONTRACT,
  // TOKEN_CONTRACT. Never deployed.
  "env": {
    "local": {
      "name": "kalien-thruput-local",
      "workers_dev": false,
      "vars": {
        "THRUPUT_RPC_URL": "http://127.0.0.1:9745",
        "THRUPUT_NETWORK_HASH": "",
        "SCORE_CONTRACT": "",
        "TOKEN_CONTRACT": "",
        "EXPLORER_URL": "",
        "RELAY_GAS_BASE": "5000000",
        "RELAY_GAS_PER_FRAME": "3000",
        "RELAY_GAS_MAX": "113000000",
        "RELAY_GAS_RETRY_MAX": "150000000",
        "RELAY_WALLET_GAS_OVERHEAD": "100000",
        "RELAY_SEED_GAS": "1000000",
        "RELAY_EXPIRY_BLOCKS": "120",
        "RELAY_MAX_IN_FLIGHT": "4",
        "LEADERBOARD_SYNC_ENABLED": "1",
        "LEADERBOARD_SYNC_MAX_PAGES": "10",
      },
      "d1_databases": [
        {
          "binding": "LEADERBOARD_DB",
          "database_name": "kalien-thruput-leaderboard",
          "database_id": "5bd1495c-f925-4571-bf8c-adde06c93236",
          "migrations_dir": "worker/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "TAPES", "bucket_name": "kalien-thruput-tapes" }],
      "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "RelayDO" }] },
      "triggers": { "crons": ["*/1 * * * *", "*/10 * * * *"] },
    },
  },
}
