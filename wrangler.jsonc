{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalien-thruput",
  "account_id": "ba55b7ae9acfb3ed152103e3497c0752",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
    },
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
  },
  "vars": {
    // Thruput devnet. Copy network/contract values from
    // shared/thruput/deployments/devnet.json after each deploy or devnet reset.
    "THRUPUT_RPC_URL": "https://rpc.thruput.network",
    // Pin; the client refuses an RPC with another identity (devnet reset). Empty = accept any.
    "THRUPUT_NETWORK_HASH": "0xb69ec9c688b3936b5bcbfc4eebc355d39aa9e5c6f6f072cc4a05564a07435047",
    "SCORE_CONTRACT": "0xed511226f0ac0d15c79d5ad85c086df105d08e93d7fa8c510b073b09e71ded81",
    "TOKEN_CONTRACT": "0x6782bfd91f64afe26d540127e80d4c98842bfce8e43cb4b3ebb612a9f5ce4844",
    "EXPLORER_URL": "https://explorer.thruput.network",
    // Relay gas (see docs/thruput/kt-worker.md). Child gas = base + per_frame * frames,
    // capped at max. Each in-flight run reserves its gas limit in free HOG.
    "RELAY_GAS_BASE": "3000000",
    "RELAY_GAS_PER_FRAME": "2300",
    "RELAY_GAS_MAX": "90000000",
    "RELAY_WALLET_GAS_OVERHEAD": "100000",
    "RELAY_SEED_GAS": "1000000",
    "RELAY_EXPIRY_BLOCKS": "120",
    "RELAY_MAX_IN_FLIGHT": "1",
    // Leaderboard indexer (ScoreSubmitted events → D1), every minute.
    "LEADERBOARD_SYNC_ENABLED": "1",
    "LEADERBOARD_SYNC_MAX_PAGES": "10",
  },
  // Secrets: RELAY_SECRET (relay Ed25519 seed, hex), DEV_API_KEY (admin routes).
  "d1_databases": [
    {
      "binding": "LEADERBOARD_DB",
      "database_name": "kalien-thruput-leaderboard",
      "database_id": "5bd1495c-f925-4571-bf8c-adde06c93236",
      "migrations_dir": "worker/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "TAPES",
      "bucket_name": "kalien-thruput-tapes",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-relay",
      "new_sqlite_classes": ["RelayDO"],
    },
  ],
  "triggers": {
    // */1: leaderboard indexer. */10: touch the current seed epoch.
    "crons": ["*/1 * * * *", "*/10 * * * *"],
  },
}
