# Cloudflare Worker local overrides (`vite dev` / `wrangler dev`).
# Copy to .dev.vars and fill in. Never commit .dev.vars.
#
# Non-secret vars live in wrangler.jsonc "vars". Values here override them
# locally, for example to point the Worker at a local node.
#
# Note: `wrangler types` reads .dev.vars. Regenerate worker-configuration.d.ts
# with .dev.vars moved aside, so the committed file matches a clean checkout.

# ── Secrets (`wrangler secret put` in production) ─────────────────────────
# Relay wallet: 32-byte Ed25519 seed as hex. It pays gas (reserved, not
# burned) for submit_score and ensure_current_seed. Keep >= 9 HOG free per
# in-flight 36,000-frame run.
RELAY_SECRET=
# Guards /api/admin/* (sync, seed touch). Omit to disable those routes.
DEV_API_KEY=

# ── Local node (thruput node --port 9745) ─────────────────────────────────
# THRUPUT_RPC_URL=http://127.0.0.1:9745
# THRUPUT_NETWORK_HASH=
# SCORE_CONTRACT=0x...
# TOKEN_CONTRACT=0x...
# EXPLORER_URL=http://127.0.0.1:9745
# LEADERBOARD_SYNC_ENABLED=0
